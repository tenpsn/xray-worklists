# ไฟล์นี้ไม่ได้ใช้ตอนรันผ่าน Docker (ใน Docker ค่า default "http://backend:4000" ใน next.config.mjs ใช้ได้เลย)
# เป็นแค่ตัวอย่างสำหรับ copy ไปทำ .env.local ตอนรัน frontend ตรงๆ ด้วย `npm run dev` (นอก Docker) เท่านั้น

# URL ภายในของ backend API ที่ frontend server ใช้ proxy request "/api/*" ไปหา (browser ไม่เห็นค่านี้)
BACKEND_INTERNAL_URL=http://localhost:4000
